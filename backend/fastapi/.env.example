APP_NAME=medical-backend
ENVIRONMENT=development
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# Neon → Dashboard → Connect → "Pooled connection" ulanish satri
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Must match admin_panel NEXT_PUBLIC_ADMIN_API_KEY (sent as x-admin-api-key)
ADMIN_API_KEY=generate-a-long-random-hex-string

# Cloudflare R2 (fayl yuklash — Supabase Storage o'rniga)
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=medicine-sbs-files
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Optional: UUID of the admin user row in public.users (moderatsiya uchun)
ADMIN_USER_ID=

# Optional: Firebase service account JSON (bir qator string) — FCM push uchun Render da o‘rnatiladi
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
